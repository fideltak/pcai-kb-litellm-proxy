server {
    listen 8080;

    client_body_temp_path /tmp/nginx-client-temp;

    location = /health {
        access_log off;
        return 200 "OK\n";
    }

    location = /stub_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
        access_log off;
    }

    location = /metrics {
        proxy_pass http://127.0.0.1:9113/metrics;
        access_log off;
    }

    location / {
        proxy_pass https://${LITELLM_HOST};

        proxy_ssl_server_name on;
        proxy_ssl_name ${LITELLM_HOST};
        proxy_ssl_trusted_certificate /etc/ezua-domain-ca-certs/ezua-domain-ca-cert.crt;
        proxy_ssl_verify on;

        proxy_http_version 1.1;
        proxy_set_header Host ${LITELLM_HOST};
        proxy_set_header Authorization "Bearer ${LITELLM_API_KEY}";

        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}